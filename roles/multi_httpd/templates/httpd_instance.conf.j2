##############################################################################
# httpd{{ item }} — auto-generated by Ansible (multi_httpd role)
# Instance number : {{ item }}
# Listening port  : {{ httpd_base_port | int + item | int - 1 }}
# DO NOT EDIT MANUALLY — re-run the playbook to apply changes.
##############################################################################

ServerRoot "{{ httpd_server_root }}"

Listen 127.0.0.1:{{ httpd_base_port | int + item | int - 1 }}

LoadModule mpm_{{ httpd_mpm_module | replace('mpm_', '') }}_module {{ httpd_modules_dir }}/mod_mpm_{{ httpd_mpm_module | replace('mpm_', '') }}.so
LoadModule unixd_module        {{ httpd_modules_dir }}/mod_unixd.so
LoadModule access_compat_module {{ httpd_modules_dir }}/mod_access_compat.so
LoadModule authz_core_module   {{ httpd_modules_dir }}/mod_authz_core.so
LoadModule authz_host_module   {{ httpd_modules_dir }}/mod_authz_host.so
LoadModule log_config_module   {{ httpd_modules_dir }}/mod_log_config.so
LoadModule env_module          {{ httpd_modules_dir }}/mod_env.so
LoadModule headers_module      {{ httpd_modules_dir }}/mod_headers.so
LoadModule setenvif_module     {{ httpd_modules_dir }}/mod_setenvif.so
LoadModule mime_module         {{ httpd_modules_dir }}/mod_mime.so
LoadModule dir_module          {{ httpd_modules_dir }}/mod_dir.so
LoadModule alias_module        {{ httpd_modules_dir }}/mod_alias.so
LoadModule rewrite_module      {{ httpd_modules_dir }}/mod_rewrite.so
LoadModule status_module       {{ httpd_modules_dir }}/mod_status.so

<IfModule unixd_module>
  User  {{ httpd_run_user }}
  Group {{ httpd_run_group }}
</IfModule>

ServerAdmin {{ httpd_server_admin }}
ServerName  127.0.0.1:{{ httpd_base_port | int + item | int - 1 }}

PidFile {{ httpd_config_root }}/httpd{{ item }}/httpd.pid

DefaultRuntimeDir /run/httpd{{ item }}

<Directory />
  AllowOverride none
  Require all denied
</Directory>

DocumentRoot "{{ httpd_doc_root }}"

<Directory "{{ httpd_doc_root }}">
  Options Indexes FollowSymLinks
  AllowOverride None
  Require all granted
</Directory>

<IfModule dir_module>
  DirectoryIndex index.html
</IfModule>

<Files ".ht*">
  Require all denied
</Files>

ErrorLog  "{{ httpd_log_root }}/httpd{{ item }}/error_log"
LogLevel  warn

<IfModule log_config_module>
  LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
  LogFormat "%h %l %u %t \"%r\" %>s %b" common
  CustomLog "{{ httpd_log_root }}/httpd{{ item }}/access_log" combined
</IfModule>

<IfModule mime_module>
  TypesConfig {{ httpd_mime_types_file }}
  AddType application/x-compress .Z
  AddType application/x-gzip .gz .tgz
</IfModule>

<IfModule mpm_event_module>
  StartServers         {{ httpd_start_servers }}
  MinSpareThreads      {{ httpd_min_spare_threads }}
  MaxSpareThreads      {{ httpd_max_spare_threads }}
  ThreadsPerChild      {{ httpd_threads_per_child }}
  MaxRequestWorkers    {{ httpd_max_request_workers }}
  MaxConnectionsPerChild {{ httpd_max_connections_per_child }}
</IfModule>

<IfModule mpm_prefork_module>
  StartServers         {{ httpd_start_servers }}
  MinSpareServers      5
  MaxSpareServers      10
  MaxRequestWorkers    {{ httpd_max_request_workers }}
  MaxConnectionsPerChild {{ httpd_max_connections_per_child }}
</IfModule>

Timeout {{ httpd_timeout }}

KeepAlive {{ httpd_keepalive }}
MaxKeepAliveRequests {{ httpd_max_keepalive_requests }}
KeepAliveTimeout {{ httpd_keepalive_timeout }}

<Location "/server-status">
  SetHandler server-status
  Require host 127.0.0.1
</Location>

ExtendedStatus On
