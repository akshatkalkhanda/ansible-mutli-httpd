# httpd{{ item }}.service — auto-generated by Ansible (multi_httpd role)
# Instance : httpd{{ item }}
# Port     : {{ httpd_base_port | int + item | int - 1 }}
# DO NOT EDIT MANUALLY — re-run the playbook to apply changes.

[Unit]
Description=Apache HTTP Server — instance httpd{{ item }} (port {{ httpd_base_port | int + item | int - 1 }})
After=network.target remote-fs.target nss-lookup.target
Documentation=man:httpd(8)
Documentation=man:apachectl(8)

[Service]
Type=notify
Environment=LANG=C

ExecStart={{ httpd_binary }} \
    -f {{ httpd_config_root }}/httpd{{ item }}/httpd.conf \
    -DFOREGROUND

ExecReload=/bin/kill -HUP $MAINPID

ExecStop=/bin/kill -WINCH $MAINPID

KillSignal=SIGCONT
PrivateTmp=true

# Ensure the run directory exists at service start
RuntimeDirectory=httpd{{ item }}
RuntimeDirectoryMode=0755

# Increase limits for high-traffic instances
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
