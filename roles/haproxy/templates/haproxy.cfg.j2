##############################################################################
# /etc/haproxy/haproxy.cfg
# Auto-generated by Ansible (haproxy role)
# Frontend : HTTPS on port {{ haproxy_frontend_port }}
# Backends : {{ haproxy_httpd_instance_count }} httpd instances
#            (127.0.0.1:{{ haproxy_httpd_base_port }} to 127.0.0.1:{{ haproxy_httpd_base_port | int + haproxy_httpd_instance_count | int - 1 }})
# DO NOT EDIT MANUALLY — re-run the playbook to apply changes.
##############################################################################

global
    log         /dev/log    local0
    log         /dev/log    local1 notice
    chroot      /var/lib/haproxy
    stats       socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats       timeout 30s
    user        haproxy
    group       haproxy
    daemon

    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    tune.ssl.default-dh-param 2048
    maxconn {{ haproxy_maxconn }}

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    option  http-server-close
    option  redispatch
    retries 3

    timeout connect {{ haproxy_timeout_connect }}
    timeout client  {{ haproxy_timeout_client }}
    timeout server  {{ haproxy_timeout_server }}

    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

##############################################################################
# Statistics dashboard
# Disabled by default. Enable with: haproxy_stats_enabled: true
# Binds to loopback only; requires haproxy_stats_user and haproxy_stats_password.
##############################################################################
{% if haproxy_stats_enabled | bool %}
frontend stats
    bind 127.0.0.1:{{ haproxy_stats_port }}
    stats enable
    stats uri     {{ haproxy_stats_uri }}
    stats refresh {{ haproxy_stats_refresh }}s
{% if haproxy_stats_user and haproxy_stats_password %}
    stats auth    {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}
{% if haproxy_stats_admin | bool %}
    stats admin   if TRUE
{% endif %}
    stats show-legends
    no log
{% endif %}

##############################################################################
# HTTP → HTTPS redirect
# Disable with: haproxy_http_redirect: false
##############################################################################
{% if haproxy_http_redirect | bool %}
frontend http_redirect
    bind *:{{ haproxy_http_port }}
    mode http
    option httplog
    redirect scheme https code 301 if !{ ssl_fc }
{% endif %}

##############################################################################
# HTTPS frontend — TLS termination, forward to httpd backend pool
##############################################################################
frontend https_frontend
    bind *:{{ haproxy_frontend_port }} ssl crt {{ haproxy_ssl_cert }}
    mode http

    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    http-response set-header X-Content-Type-Options "nosniff"
    http-response set-header X-Frame-Options "SAMEORIGIN"
    http-response set-header X-XSS-Protection "1; mode=block"

    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port {{ haproxy_frontend_port }}

    default_backend httpd_pool

##############################################################################
# Backend pool — {{ haproxy_httpd_instance_count }} httpd instances
##############################################################################
backend httpd_pool
    mode    http
    balance {{ haproxy_balance }}

    option  httpchk GET /server-status HTTP/1.0
    http-check expect status 200

{% for i in range(1, haproxy_httpd_instance_count | int + 1) %}
    server httpd{{ i }} 127.0.0.1:{{ haproxy_httpd_base_port | int + i - 1 }} check inter {{ haproxy_health_check_interval }} fall {{ haproxy_health_check_fall }} rise {{ haproxy_health_check_rise }}
{% endfor %}
